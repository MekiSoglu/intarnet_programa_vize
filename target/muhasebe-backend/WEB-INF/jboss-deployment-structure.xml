<?xml version="1.0" encoding="UTF-8"?>
<!--
  EclipseLink'i Hibernate yerine kullanmak icin konfigurasyon.
  JPA subsystem'ini kapatmiyoruz (persistence unit'i bulmasi icin lazim);
  sadece Hibernate modulunu exclude ediyoruz.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">
    <deployment>
        <exclusions>
            <module name="org.hibernate"/>
            <module name="org.hibernate.jipijapa-hibernate5"/>
        </exclusions>
    </deployment>
</jboss-deployment-structure>
